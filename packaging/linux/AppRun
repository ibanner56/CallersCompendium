#!/bin/sh
# AppRun entrypoint for the Caller's Compendium AppImage.
#
# The Flutter Linux release bundle (the `compendium_app` executable plus its
# `lib/` and `data/` siblings) is staged under usr/bin/ inside the AppDir, so we
# resolve our own location, put that directory on PATH (so the engine finds its
# co-located libraries), and exec the app forwarding all arguments.
set -eu

HERE="$(dirname "$(readlink -f "${0}")")"
export PATH="${HERE}/usr/bin:${PATH}"
# Append any existing value only when it is non-empty: a trailing ":" is an
# empty entry, which the loader reads as the current directory, so a library
# dropped next to the AppImage (e.g. in ~/Downloads) would load first.
export LD_LIBRARY_PATH="${HERE}/usr/bin/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
exec "${HERE}/usr/bin/compendium_app" "$@"
