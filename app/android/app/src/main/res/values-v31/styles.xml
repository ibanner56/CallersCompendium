<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the brand Soft Dark surface (#1E2A38, same as
         the launcher-icon background) behind the launcher icon, in both light
         and dark. Both qualifiers exist because values-night outranks values-v31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
